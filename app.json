{
  "expo": {
    "name": "PandaGO!",
    "slug": "pandago",
    "scheme": "pandago",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.pandago",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PandaGO! usa el micrófono para evaluar tu pronunciación del chino."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "app.pandago",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8561F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFE7DA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#11141C"
          }
        }
      ],
      "expo-font",
      "./plugins/withReleaseSigning",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PandaGO! usa la cámara para que Bao te explique carteles, menús y textos en chino.",
          "photosPermission": "PandaGO! usa tus fotos para que Bao te explique textos en chino."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Bao",
              "label": "Bao · palabra del día",
              "description": "Bao, tu racha, la palabra del día y el asistente a un toque",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BaoMini",
              "label": "Bao (pequeño)",
              "description": "Toca a Bao y te escucha",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-mini-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withBaoAssistant"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8787"
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
